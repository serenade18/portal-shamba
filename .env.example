# Where API calls go. Leave as /api/v1 in development (Vite proxies it to Django on :8000).
VITE_API_BASE=/api/v1

# Which API routes are served by the in-browser mock instead of the backend:
#   all      everything is mocked; runs with no backend (demo data, any OTP works)
#   missing  routes the backend already has go to the backend; the rest are mocked
#   none     no mocking; every route goes to the backend
VITE_MOCK=all

# Optional. A Cesium ion access token (https://ion.cesium.com/tokens) adds 3D world terrain to the maps.
# Without one the maps use flat terrain over Esri satellite imagery.
VITE_CESIUM_ION_TOKEN=
