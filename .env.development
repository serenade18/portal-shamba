# Where API calls go. Leave as /api/v1 in development (Vite proxies it to Django on :8000).
VITE_API_BASE=/api/v1

# Which API routes are served by the in-browser mock instead of the backend:
#   all      everything is mocked; runs with no backend (demo data). `npm run dev:demo` uses this.
#   missing  routes shambaos-backend already has go to it; the rest are mocked
#   none     no mocking; every route goes to the backend
VITE_MOCK=missing
